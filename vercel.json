{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://pogaca-frieren.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "https://pogaca-frieren.onrender.com/$1"
    }
  ]
}
