# Discord Developer Portal > Bot
DISCORD_TOKEN=BOT_TOKENUNU_BURAYA_YAZ

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=UYGULAMA_ID_BURAYA

# İsteğe bağlı: Komutları yalnızca test sunucuna anında kaydetmek için
GUILD_ID=TEST_SUNUCU_ID_BURAYA

# Render PostgreSQL bağlantı adresi (External/Internal URL kullanımına göre Render'dan kopyala)
DATABASE_URL=POSTGRES_BAGLANTI_ADRESI

# Render dış bağlantısında TLS gerekiyorsa true yap. Internal URL için Render'ın verdiği yönergeyi izle.
PGSSL=false

# İsteğe bağlı boss görselleri (HTTPS ile erişilebilen PNG/JPG/WebP/GIF URL'leri)
POGACA_BOSS_ART_SCHATTENWOLF_URL=
POGACA_BOSS_ART_RUIN_GUARDIAN_URL=
POGACA_BOSS_ART_NORTH_DEMON_URL=
POGACA_BOSS_ART_DEMON_COMMANDER_URL=
POGACA_BOSS_ART_AUSSERST_LORD_URL=
POGACA_RAID_ART_NORTH_GENERAL_URL=
POGACA_RAID_ART_GLASS_WYRM_URL=
POGACA_RAID_ART_FALLEN_MAGE_URL=
POGACA_DUNGEON_FINAL_BOSS_ART_URL=

# Frieren sohbeti: Groq ücretsiz katman API anahtarı (Render Secret olarak ekle; GitHub'a koyma)
GROQ_API_KEY=
FRIEREN_CHAT_MODEL=openai/gpt-oss-20b
FRIEREN_CHAT_TIMEOUT_MS=45000

# Owner paneli: Discord Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# En az 32 karakterlik rastgele oturum imzalama anahtarı (Render Secret)
ADMIN_SESSION_SECRET=
# Discord OAuth2 redirect URI ile birebir aynı olmalı
OWNER_DASHBOARD_REDIRECT_URI=https://pogaca-frieren.onrender.com/owner/callback
