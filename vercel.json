{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pogaca-frieren.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://pogaca-frieren.onrender.com/:path*"
    }
  ]
}
