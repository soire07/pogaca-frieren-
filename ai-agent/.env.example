# Create a SEPARATE Discord application/bot for this agent.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Free-tier Groq API key. Never commit a real key.
GROQ_API_KEY=
FRIEREN_MODEL_PROVIDER=groq
FRIEREN_MODEL=openai/gpt-oss-20b

# Comma-separated Discord user IDs allowed to run diagnostics/tests.
FRIEREN_ADMIN_IDS=

# Optional: cap one test run; default 180 seconds.
FRIEREN_TEST_TIMEOUT_MS=180000
