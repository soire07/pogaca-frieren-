# Create a SEPARATE Discord application/bot for this agent.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1564945192803639356 # Required: Frieren AI test server only

# Free-tier Groq API key. Never commit a real key.
GROQ_API_KEY=
FRIEREN_MODEL_PROVIDER=groq
FRIEREN_MODEL=openai/gpt-oss-20b

# Shared Frieren Neural provider (same endpoint/token on Poğaça Frieren and Frieren AI).
# Keep quality approval disabled until provenance, held-out metrics and human review pass.
FRIEREN_NEURAL_API_URL=
FRIEREN_NEURAL_API_TOKEN=
FRIEREN_NEURAL_QUALITY_APPROVED=0
FRIEREN_NEURAL_REQUEST_TIMEOUT_MS=300000


# Comma-separated Discord user IDs allowed to run diagnostics/tests.
FRIEREN_ADMIN_IDS=

# Optional: cap one test run; default 180 seconds.
FRIEREN_TEST_TIMEOUT_MS=180000
