# Create a separate Discord application/bot for this agent.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Free OpenAI-compatible API key. Create it at https://chat.merkium.nl/
FRIEREN_AI_API_KEY=
FRIEREN_AI_BASE_URL=https://chat.merkium.nl/api/v1
